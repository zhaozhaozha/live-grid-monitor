# Live Grid Monitor 运行配置
# 修改后需停止并重新启动服务才会生效

# 服务端口。桌面快捷方式会读取这里的值来决定打开哪个地址。
PORT=8787

# 直播间数据轮询间隔（秒）。过低可能触发平台风控。
POLL_INTERVAL_SEC=30

# 需要登录才能取到标题/在线人数的平台，可在此填入 Cookie（可选）
# 获取方式：浏览器登录后 F12 → Network → 复制请求头里的 cookie 值
# DOUYIN_COOKIE=
# JD_COOKIE=
# KUAISHOU_COOKIE=
# TAOBAO_COOKIE=
# XHS_COOKIE=
