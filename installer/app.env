# Live Grid Monitor 运行配置
# 修改后需停止并重新启动服务才会生效

# 服务端口。桌面快捷方式会读取这里的值来决定打开哪个地址。
PORT=8787

# 直播间数据轮询间隔（秒）。过低可能触发平台风控。
POLL_INTERVAL_SEC=30

# 需要登录才能取到标题/在线人数的平台，可在此填入 Cookie（可选）
# 获取方式：浏览器登录后 F12 → Network → 复制请求头里的 cookie 值
# DOUYIN_COOKIE=
# JD_COOKIE=
# KUAISHOU_COOKIE=
# TAOBAO_COOKIE=
# XHS_COOKIE=

# —— 广告自动识别 ——
# v1.0.2 起在服务端抽帧识别：关掉浏览器页面也会继续记录，
# 无需一直开着监控页。每路每秒 1 帧（约 72 字节），开销很小。

# 广告判定阈值（0~1）。调低更敏感（易误报），调高更保守（易漏报）。
AD_SCORE_THRESHOLD=0.62

# 低配机器或多路同开时，可设为 0 关闭广告采样以省 CPU。
# AD_SAMPLER_ENABLED=0

# 单场直播时长上限（秒），超过会强制切场，防止异常场次累积成几十小时的假数据。
MAX_SESSION_SEC=86400
